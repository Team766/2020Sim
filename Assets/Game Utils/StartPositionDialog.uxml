<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Robot%20Designer/Dialog.uss?fileID=7433441132597879392&amp;guid=07fcdc08799d0449886b7a5b317b8de3&amp;type=3#Dialog" />
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.5); padding-top: 2%; padding-right: 5%; padding-bottom: 2%; padding-left: 5%; align-items: center; justify-content: center; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 1; background-color: rgb(175, 144, 144); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); max-width: 500px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:Vector2Field label="Robot Start Position" name="position" />
            <ui:FloatField label="Robot Start Heading" value="0" name="heading" />
            <ui:RadioButtonGroup choices="Blue,Red (mirrored)" name="coordinate-team" label="Alliance" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-evenly; margin-top: 16px;">
                <ui:Button text="Team 1" name="button-team1" />
                <ui:Button text="Team 2" name="button-team2" />
                <ui:Button text="Team 3" name="button-team3" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 16px;">
                <ui:Button text="Cancel" name="button-cancel" />
                <ui:Button text="Save" name="button-save" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
