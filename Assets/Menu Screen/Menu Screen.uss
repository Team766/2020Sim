:root {
}

.level-button {
    font-size: 330%;
    background-color: rgb(70, 16, 120);
    color: rgb(56, 243, 234);
    -unity-text-outline-color: rgb(208, 13, 248);
    -unity-text-outline-width: 4px;
    -unity-font-style: normal;
    border-left-color: rgb(191, 13, 228);
    border-right-color: rgb(191, 13, 228);
    border-top-color: rgb(191, 13, 228);
    border-bottom-color: rgb(191, 13, 228);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 15px;
    padding-right: 12px;
    padding-bottom: 15px;
    padding-left: 12px;
}

.level-button:hover {
    -unity-text-outline-color: rgb(55, 243, 234);
    background-color: rgb(89, 20, 153);
}

.level-button:active {
    border-left-color: rgb(55, 243, 234);
    border-right-color: rgb(55, 243, 234);
    border-top-color: rgb(55, 243, 234);
    border-bottom-color: rgb(55, 243, 234);
    background-color: rgb(96, 22, 166);
}
