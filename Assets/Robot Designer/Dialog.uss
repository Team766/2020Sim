:root {
}

.unity-button {
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    flex-shrink: 0;
}

.unity-radio-button-group__container {
    flex-direction: row;
    justify-content: center;
}

.unity-vector2-field .unity-base-text-field__label {
    flex-shrink: 1;
    flex-grow: 0;
    width: auto;
    min-width: auto;
    padding-right: 10px;
}
